{
  "name": "minds-of-the-future",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:rls": "vitest run tests/unit/schema.test.ts tests/unit/rls.test.ts",
    "test:watch": "vitest",
    "load:seed": "node tests/load/seed-submission-spike.mjs",
    "load:spike": "cd tests/load && k6 run submission-spike.js",
    "load:teardown": "node tests/load/seed-submission-spike.mjs --teardown",
    "load:scoring:seed": "node tests/load/seed-scoring-spike.mjs",
    "load:scoring:spike": "cd tests/load && k6 run scoring-spike.js",
    "load:scoring:teardown": "node tests/load/seed-scoring-spike.mjs --teardown",
    "e2e": "playwright test",
    "types:generate": "supabase gen types typescript --local > lib/database.types.ts || supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > lib/database.types.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.487.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.17.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "ws": "^8.21.3"
  }
}
