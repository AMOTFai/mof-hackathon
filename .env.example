# SQLite for local dev. Swap for a Postgres URL to deploy (and change provider in schema.prisma).
DATABASE_URL="file:./dev.db"

# Optional: enables real AI log review on the judge dashboard.
# Without it, a deterministic heuristic summary is used so the dashboard still works.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Optional: raises GitHub API rate limits when pulling commit history.
GITHUB_TOKEN=""

# Optional: public origin used to build the API-proxy setup instructions shown to
# teams. Inferred from the request host if unset (fine for local + previews).
NEXT_PUBLIC_APP_URL=""
