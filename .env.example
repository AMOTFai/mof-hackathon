# Supabase — verify the project is EU (London / eu-west-2) BEFORE the first migration.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: `supabase gen types` against a hosted project.
SUPABASE_PROJECT_ID=""

# Server-only. Direct Postgres connection, used to apply additive migrations
# with psql. Use the SESSION POOLER host (aws-0-<region>.pooler.supabase.com):
# the direct db.<ref>.supabase.co host is IPv6-only.
SUPABASE_DB_URL=""

# Required for the scheduled commit poll at /api/cron/sync-commits. The route
# fails closed (401) when unset, so cron is simply off until you set it.
CRON_SECRET=""

# Optional integrations — the app degrades without them.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
GITHUB_TOKEN=""
RESEND_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry — optional, degrades to no-op without SENTRY_DSN. Server/edge use
# SENTRY_DSN; the browser needs the NEXT_PUBLIC_ variant separately since it's
# a different bundle. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only for
# uploading source maps at build time — leave unset locally.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
